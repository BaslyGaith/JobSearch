# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=jobfinder
POSTGRES_USER=jobfinder
POSTGRES_PASSWORD=change_me_in_production

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Microsoft OAuth2 ─────────────────────────────────────────────────────────
# Create credentials at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/microsoft
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ─── LinkedIn (Optional — Sprint 2) ───────────────────────────────────────────
# Set LINKEDIN_MOCK_MODE=false and fill credentials for real LinkedIn OAuth
LINKEDIN_MOCK_MODE=true
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── Application ──────────────────────────────────────────────────────────────
# Used for OAuth2 redirect and CORS. Set to your domain in production.
APP_FRONTEND_URL=http://localhost:5173

# Job sources (optional)
# Greenhouse/Lever need only a company board name - no account, no key.
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
# France Travail credentials from https://francetravail.io
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Local CV model (optional)
CV_OLLAMA_ENABLED=true
CV_OLLAMA_URL=http://localhost:11434
CV_OLLAMA_MODEL=llama3
